public List<List<Integer>> threeSum(int[] nums) {
    Arrays.sort(nums);               // Step 1: Sort the array
    List<List<Integer>> result = new ArrayList<>();

    for (int i = 0; i < nums.length - 2; i++) {  // Step 2: Fix first element

        // Duplicate skip karo for i
        if (i > 0 && nums[i] == nums[i - 1]) continue;

        int left = i + 1;                // Step 3: left pointer
        int right = nums.length - 1;     // Step 4: right pointer

        while (left < right) {           // Step 5: two pointer loop
            int sum = nums[i] + nums[left] + nums[right];

            if (sum == 0) {              // ✅ Triplet found!
                result.add(Arrays.asList(nums[i], nums[left], nums[right]));

                // Duplicates skip karo for left
                while (left < right && nums[left] == nums[left + 1]) left++;
                // Duplicates skip karo for right
                while (left < right && nums[right] == nums[right - 1]) right--;

                left++;   // aage badho
                right--;  // peeche aao

            } else if (sum < 0) {
                left++;   // sum chhota hai, left badhao (value increase hogi)
            } else {
                right--;  // sum bada hai, right ghatao (value decrease hogi)
            }
        }
    }
    return result;
}
